<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Global arguemnts -->
  <arg default="true" description="use_sim_time" name="use_sim_time"></arg>
  <arg default="civic" description="vehicle model name" name="vehicle_model"></arg>
  
    <!-- Spawn Vehicle arguments -->
  <include file="$(find-pkg-share vehicle_sim)/launch/vehicle.launch.xml">
    <arg name="vehicle_model" value="$(var vehicle_model)"></arg>
  </include>
  <!-- RVIZ -->
  <node args="-d $(find-pkg-share sim_launch)/config/rviz/rviz_config.rviz" exec="rviz2" name="rviz" pkg="rviz2"></node>
</launch>
